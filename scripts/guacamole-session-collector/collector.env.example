# Copy to /etc/drcc/guacamole-session-collector.env (chmod 600, root-owned) on the
# Guacamole host. Nothing here is ever given to Vercel: the portal only receives
# the sanitized session rows this collector posts.
GUAC_DB_CONTAINER=guac-postgres
GUAC_DB_NAME=guacamole_db
GUAC_DB_USER=guac_portal_ro
PGPASSWORD=
# Optional: reachability of the Guacamole web application, reported as connector
# health so an outage is visible in Live Operations instead of an empty list.
GUAC_WEB_URL=https://guac.01.digitalrcc.com
DRCC_INGEST_URL=https://my.digitalrcc.com/api/integrations/guacamole/sessions
GUACAMOLE_INGEST_SECRET=
GUAC_LOOKBACK_HOURS=48
# 0 runs once and exits, which is what the bundled systemd timer expects.
POLL_INTERVAL_SECONDS=0
