# Copy to /etc/drcc/lab-status-poller.env (chmod 600, owned by drcc-monitor).
# The Proxmox token secret stays on this host; it is never given to Vercel.
PROXMOX_API_BASE_URL=https://192.168.1.90:8006
PROXMOX_API_TOKEN_ID=drcc-monitor@pve!lab-status
PROXMOX_API_TOKEN_SECRET=
# Path to the Proxmox cluster CA (/etc/pve/pve-root-ca.pem copied from the node),
# or "false" to skip verification on the trusted lab network.
PROXMOX_VERIFY_TLS=/etc/drcc/pve-root-ca.pem
DRCC_INGEST_URL=https://my.digitalrcc.com/api/lab-status/ingest
LAB_STATUS_INGEST_SECRET=
POLL_INTERVAL_SECONDS=45
