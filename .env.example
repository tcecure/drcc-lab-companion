NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=

# Email delivery: "mock" (default) records email jobs as sent without contacting
# a provider. Set to "live" only when the SES values below are configured.
EMAIL_DELIVERY_MODE=mock
SES_FROM_ADDRESS=
SES_REPLY_TO_ADDRESS=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional Proxmox read-only status integration
PROXMOX_API_BASE_URL=https://proxmox.example.org:8006
PROXMOX_API_TOKEN_ID=monitor@pve!digitalrcc-status
PROXMOX_API_TOKEN_SECRET=
PROXMOX_EXPECTED_NODES=dc1,dc2
PROXMOX_EXPECTED_PODS=student01,student02,student03

# Backward-compatible aliases also work:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
