NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=

# Email delivery: "mock" (default) records email jobs as sent without contacting
# a provider. Set to "live" only after at least one provider is configured.
EMAIL_DELIVERY_MODE=mock

# Portal support mail. Authenticate as the licensed Workspace user; Gmail sends
# through the verified support@ alias. A separate app password is recommended.
SUPPORT_EMAIL_DELIVERY_MODE=mock
SUPPORT_EMAIL=support@digitalrcc.com
SUPPORT_NOTIFY_EMAIL=cyberlab@tcecure.com
SUPPORT_FROM_NAME=Digital Resilience Community Clinic Support
SUPPORT_SMTP_HOST=smtp.gmail.com
SUPPORT_SMTP_PORT=465
SUPPORT_SMTP_USER=admin@digitalrcc.com
SUPPORT_SMTP_PASSWORD=

# Existing queue/cohort mail provider.
SES_FROM_ADDRESS=
SES_REPLY_TO_ADDRESS=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional Proxmox read-only status integration
PROXMOX_API_BASE_URL=https://proxmox.example.org:8006
PROXMOX_API_TOKEN_ID=monitor@pve!digitalrcc-status
PROXMOX_API_TOKEN_SECRET=
PROXMOX_EXPECTED_NODES=dc1,dc2
PROXMOX_EXPECTED_PODS=student01,student02,student03

# Backward-compatible aliases also work:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
